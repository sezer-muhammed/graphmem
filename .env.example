# GraphMem — Oracle ADB connection (copy to .env and fill in; never commit .env)
# a dedicated least-privilege schema user (see README step 3) - never ADMIN
ADB_USER=graphmem_app
ADB_PASSWORD=your-app-user-password
ADB_DSN=mydb_low
# absolute path to the unzipped wallet directory on THIS machine
ADB_WALLET_DIR=/absolute/path/to/wallet
ADB_WALLET_PASSWORD=your-wallet-password
# optional: OCID enables lifecycle ops (keepalive auto-start) via OCI instance principal
ADB_OCID=
# optional: OCI region for lifecycle ops (defaults to us-ashburn-1)
ADB_REGION=
# optional: web explorer basic auth (both must be set to enable)
GRAPHMEM_WEB_USER=
GRAPHMEM_WEB_PASSWORD=
